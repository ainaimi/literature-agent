# Copy relevant lines from this file into ~/.env and fill in your values.
# The agent loads ~/.env automatically at runtime.

# ─── LLM API Keys ─────────────────────────────────────────────────────────────
# Only the key matching your LLM_PROVIDER in config.py is required.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Gmail is recommended. Use an App Password, not your account password.
# Generate one at: myaccount.google.com/apppasswords
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password

# Recipient address (can be same as SMTP_USERNAME, or a different address)
EMAIL_TO=you@institution.edu

# Optional overrides — defaults shown, only set if you need to change them:
# EMAIL_FROM=you@gmail.com       ← defaults to SMTP_USERNAME
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# ─── Semantic Scholar (optional) ──────────────────────────────────────────────
# Raises the rate limit 6x. Free key at: semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=
